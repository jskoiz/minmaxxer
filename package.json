{
  "name": "minmaxxer",
  "version": "0.1.0",
  "description": "Local-only Codex usage snapshot and automation gate over Codex CLI RPC.",
  "author": "jskoiz",
  "homepage": "https://github.com/jskoiz/minmaxxer#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jskoiz/minmaxxer.git"
  },
  "bugs": {
    "url": "https://github.com/jskoiz/minmaxxer/issues"
  },
  "type": "module",
  "bin": {
    "minmaxxer": "dist/bin/minmaxxer.js"
  },
  "files": [
    "dist/bin",
    "dist/src",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/bin/minmaxxer.js', 0o755)\"",
    "prepare": "npm run build",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "check": "npm test && node dist/bin/minmaxxer.js --help"
  },
  "keywords": [
    "codex",
    "usage",
    "automation",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  }
}
